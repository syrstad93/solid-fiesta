@startuml
title Smart Home System - Component Diagram

top to bottom direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho

actor "User" as User

package "JavaFX GUI" {
  [GUI]
}

package "Devices" {
  [Controller]
  [Device]
  [Actuator]
  [Sensor]

  [Controller] --|> [Device]
  [Actuator] --|> [Device]
  [Sensor] --|> [Device]
}

package "Network Communication" {
  [ClientConnectionHolder]
  [Device] --> [ClientConnectionHolder]
  [Controller] --> [ClientConnectionHolder]
}

package "Server" {
  component "Server" as ServerComponent
  [ServerLogic]
  [ClientHandler]
  [ClientHandlerList]
  [Room]
  [RoomList]
  [RoomLogic]
  [ClientDirectory]
  [Subscriptions]
  [AutomationEngine]

  ServerComponent *-- [ServerLogic]
  ServerComponent *-- [ClientHandlerList]
  ServerComponent --> [ClientHandler]

  [ServerLogic] --> [ClientHandlerList]
  [ServerLogic] --> [RoomList]
  [ServerLogic] --> [ClientDirectory]
  [ServerLogic] --> [Subscriptions]
  [ServerLogic] --> [AutomationEngine]

  [RoomList] *-- [Room]
  [Room] *-- [RoomLogic]
}

User --> [GUI]
[GUI] --> [Controller] : commands and state

[ClientConnectionHolder] --> ServerComponent : TCP
[ClientHandler] --> [ServerLogic]

@enduml